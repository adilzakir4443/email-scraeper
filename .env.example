# Copy this to .env and fill in your values.
# The tool reads this file automatically on startup.

# Comma-separated list of proxy endpoints (http://user:pass@host:port format)
# Leave blank to run without proxies (expect rate-limiting on target sites)
PROXY_POOL=http://user1:pass1@proxy1.example.com:8080,http://user2:pass2@proxy2.example.com:8080
